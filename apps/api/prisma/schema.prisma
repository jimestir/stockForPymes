generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CLIENT
  PHARMACY
  ADMIN
}

model Pharmacy {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  address   String
  cp        String
  lat       Float?
  lng       Float?
  phone     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users     User[]
  inventory Inventory[]

  @@map("pharmacies")
}

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  products Product[]

  @@map("categories")
}

model Product {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  description String?
  categoryId  String?  @map("category_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  category  Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  inventory Inventory[]

  @@index([name])
  @@index([categoryId])
  @@map("products")
}

model Inventory {
  id         String   @id @default(uuid()) @db.Uuid
  pharmacyId String   @map("pharmacy_id") @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  stock      Int      @default(0)
  price      Decimal  @db.Decimal(10, 2)
  version    Int      @default(1) //  contron de concurrencia (para evitar la compras simultaneas entre usuarios)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([pharmacyId, productId])
  @@index([productId])
  @@index([pharmacyId])
  @@map("inventory")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  role         UserRole   @default(CLIENT)
  phone        String?
  pharmacyId   String?  @map("pharmacy_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  pharmacy Pharmacy? @relation(fields: [pharmacyId], references: [id], onDelete: SetNull)

  @@map("users")
}