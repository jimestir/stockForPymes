{
  "name": "stock-for-pymes",
  "description": "Stock for PYMEs — plataforma ROPO de stock y reservas para farmacias locales",
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev -w @stock-pymes/api",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:migrate": "prisma migrate dev --schema apps/api/prisma/schema.prisma",
    "db:admin": "npm run db:admin -w @stock-pymes/api",
    "db:seed": "npm run db:seed -w @stock-pymes/api"
  },
  "allowScripts": {
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true,
    "@prisma/client@6.19.3": true
  },
  "devDependencies": {
    "prisma": "^6.19.3"
  }
}
