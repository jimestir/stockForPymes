# PostgreSQL (debe coincidir con docker-compose.yml)
POSTGRES_USER=stock
POSTGRES_PASSWORD=stock_dev_password
POSTGRES_DB=stock_for_pymes
POSTGRES_PORT=5432

# Prisma / API
DATABASE_URL=postgresql://stock:stock_dev_password@localhost:5432/stock_for_pymes?schema=public

# JWT
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRES_IN=8h

# API
API_PORT=3000
API_HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Rate limiting (opcional, tienen defaults)
# AUTH_RATE_LIMIT_WINDOW_MS=900000
# AUTH_RATE_LIMIT_MAX=10

# Admin seed (opcional, usado por `npm run db:admin`)
# ADMIN_EMAIL=admin@stockpymes.local
# ADMIN_PASSWORD=Admin1234!
# ADMIN_NAME=Administrador

